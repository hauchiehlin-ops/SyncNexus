<Window x:Class="SyncNexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Height="600" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="188"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar: sections of the main window, plus conflicts / manual / privacy -->
    <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,16">
            <StackPanel DockPanel.Dock="Bottom">
                <Button x:Name="NavBtnConflicts" Content="⚡ 衝突管理" Padding="10,7" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Click="BtnConflicts_Click"/>
                <Button x:Name="NavBtnManual" Content="📖 操作手冊" Padding="10,7" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Click="BtnManual_Click"/>
                <Button x:Name="NavBtnPrivacy" Content="🛡️ 隱私政策" Padding="10,7" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Click="BtnPrivacy_Click"/>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,0,0,14">
                    <TextBlock Text="🔄" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SyncNexus" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" SelectedIndex="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem x:Name="NavOverview" Content="🏠 概覽" Padding="10,8" FontSize="14"/>
                    <ListBoxItem x:Name="NavActivity" Content="📈 同步動態" Padding="10,8" FontSize="14"/>
                    <ListBoxItem x:Name="NavSettings" Content="⚙️ 設定" Padding="10,8" FontSize="14"/>
                </ListBox>
            </StackPanel>
        </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="MyTaskbarIcon"
                        ToolTipText="SyncNexus"
                        TrayMouseDoubleClick="MyTaskbarIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <!-- built in code each time it opens: open / sync, one entry per sync group with its folders, quit -->
                <ContextMenu x:Name="TrayMenu" Opened="TrayMenu_Opened"/>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="🔄" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="SyncNexus" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                    <TextBlock x:Name="TxtSubtitle" Text="跨平台即時同步中心 (Windows / macOS / Android)" FontSize="12" Foreground="#6E6E6E"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 介面語系下拉式選單 -->
                <ComboBox x:Name="CmbLanguage" Width="95" Height="28" Margin="0,0,8,0" SelectionChanged="CmbLanguage_SelectionChanged">
                    <ComboBoxItem Content="繁體中文"/>
                    <ComboBoxItem Content="简体中文"/>
                    <ComboBoxItem Content="English"/>
                    <ComboBoxItem Content="日本語"/>
                    <ComboBoxItem Content="한국어"/>
                    <ComboBoxItem Content="ภาษาไทย"/>
                </ComboBox>

                <Button x:Name="BtnAddEndpoint" Content="+ 新增端點" Padding="12,6" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CCCCCC"
                        FontWeight="SemiBold" Click="BtnAddEndpoint_Click"/>
                <Button x:Name="BtnSyncNow" Content="立即對帳" Padding="14,6" Background="#0078D4" Foreground="White"
                        FontWeight="SemiBold" Command="{Binding TriggerSyncCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Status Card -->
        <Border x:Name="StatusCard" Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                BorderBrush="#E5E5E5" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTrackedLabel" Text="追蹤中檔案：" FontSize="13" Foreground="#444444"/>
                    <TextBlock Text="{Binding TrackedFilesCount}" FontWeight="Bold" FontSize="13" Foreground="#0078D4" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtLanLabel" Text="區域網路探索：" FontSize="13" Foreground="#444444"/>
                    <TextBlock x:Name="TxtLanValue" Text="在線（相容 Mac Bonjour / Android）" FontSize="13" Foreground="#137333"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontSize="13" Foreground="#6E6E6E"/>
            </DockPanel>
        </Border>

        <!-- Sync group bar: switch between groups; new / edit / delete -->
        <Border x:Name="GroupBar" Grid.Row="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="#E5E5E5" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnGroupRestore" Content="從備份還原" Padding="10,4" Margin="8,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Click="BtnGroupRestore_Click"/>
                    <Button x:Name="BtnGroupImport" Content="匯入舊設定" Padding="10,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Click="BtnGroupImport_Click"/>
                    <Button x:Name="BtnGroupNew" Content="＋ 新增群組" Padding="10,4" Margin="8,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Click="BtnGroupNew_Click"/>
                    <Button x:Name="BtnGroupEdit" Content="編輯群組" Padding="10,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Click="BtnGroupEdit_Click"/>
                    <Button x:Name="BtnGroupDelete" Content="刪除群組" Padding="10,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Foreground="#C5221F" Click="BtnGroupDelete_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtGroupTitle" Text="同步群組" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroupItem, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding IconEmoji}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Endpoints List -->
        <GroupBox x:Name="EndpointsBox" Grid.Row="3" Header="同步端點 (本機 / Google Drive / OneDrive / 外接磁碟)" Padding="10" Background="White"
                  BorderBrush="#E5E5E5" BorderThickness="1">
            <ListBox ItemsSource="{Binding Endpoints}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10" Margin="0,4"
                                BorderBrush="#EDEDED" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" Foreground="#222222"/>
                                    <TextBlock Text="{Binding Root}" FontSize="12" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="#E6F4EA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Background" Value="#FCE8E6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="#137333"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Foreground" Value="#C5221F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Sync activity: what the engine did recently -->
        <GroupBox x:Name="ActivityBox" Grid.Row="3" Header="同步動態" Padding="10" Background="White"
                  BorderBrush="#E5E5E5" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <ListBox ItemsSource="{Binding RecentLogs}" BorderThickness="0" Background="Transparent"/>
                <TextBlock x:Name="TxtActivityEmpty" Text="尚無同步動態" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentLogs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- Settings Bar -->
        <Border x:Name="SettingsBar" Grid.Row="3" VerticalAlignment="Top" Visibility="Collapsed" Background="#FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,0"
                BorderBrush="#E5E5E5" BorderThickness="1">
            <DockPanel>
                <CheckBox x:Name="ChkAutoStart" Content="開機時自動於背景啟動 SyncNexus" VerticalAlignment="Center"
                          Click="ChkAutoStart_Click"/>
                <CheckBox x:Name="ChkFolderIcons" Content="資料夾圖示跟隨同步群組" VerticalAlignment="Center" Margin="16,0,0,0"
                          Click="ChkFolderIcons_Click"/>
                <TextBlock x:Name="TxtDaemon" Text="守護行程常駐運行中" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#888"/>
            </DockPanel>
        </Border>

        <!-- Footer / Logs -->
        <StatusBar Grid.Row="5" Background="Transparent" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtFooter" Text="✅ 守護行程運作中 · 支援長路徑與雲端佔位符感應 · 系統匣就緒" FontSize="11" Foreground="#888888"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    </Grid>
</Window>
