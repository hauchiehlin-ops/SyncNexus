<Window x:Class="SyncNexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Height="680" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation: 8 Core Sections + Manual / Privacy -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E4E8" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16">
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="4,8" Background="#E8EAED"/>
                    <Button x:Name="NavBtnManual" Content="📖 操作手冊" Padding="10,7" Margin="0,0,0,4" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnManual_Click"/>
                    <Button x:Name="NavBtnPrivacy" Content="🛡️ 隱私政策" Padding="10,7" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnPrivacy_Click"/>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,16">
                        <TextBlock Text="🔄" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="SyncNexus" FontSize="18" FontWeight="Bold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" SelectedIndex="0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem x:Name="NavOverview" Content="🏠 概覽"/>
                        <ListBoxItem x:Name="NavPreview" Content="📋 差異預覽"/>
                        <ListBoxItem x:Name="NavFolders" Content="📁 資料夾"/>
                        <ListBoxItem x:Name="NavActivity" Content="📈 同步動態"/>
                        <ListBoxItem x:Name="NavConflicts" Content="⚡ 衝突管理"/>
                        <ListBoxItem x:Name="NavVersions" Content="🕒 舊版本"/>
                        <ListBoxItem x:Name="NavVerify" Content="🛡️ 驗證紀錄"/>
                        <ListBoxItem x:Name="NavSettings" Content="⚙️ 設定"/>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- System Tray Icon -->
            <tb:TaskbarIcon x:Name="MyTaskbarIcon"
                            ToolTipText="SyncNexus"
                            TrayMouseDoubleClick="MyTaskbarIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu x:Name="TrayMenu" Opened="TrayMenu_Opened"/>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- Header Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SyncNexus" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                        <TextBlock x:Name="TxtSubtitle" Text="跨平台即時同步中心 (Windows / macOS / Android)" FontSize="12" Foreground="#666666"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbLanguage" Width="95" Height="28" Margin="0,0,8,0" SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="繁體中文"/>
                        <ComboBoxItem Content="简体中文"/>
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="日本語"/>
                        <ComboBoxItem Content="한국어"/>
                        <ComboBoxItem Content="ภาษาไทย"/>
                    </ComboBox>

                    <Button x:Name="BtnAddEndpoint" Content="+ 新增端點" Padding="12,6" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CCCCCC"
                            FontWeight="SemiBold" Cursor="Hand" Click="BtnAddEndpoint_Click"/>
                    <Button x:Name="BtnSyncNow" Content="立即對帳" Padding="14,6" Background="#0078D4" Foreground="White"
                            FontWeight="SemiBold" Cursor="Hand" Command="{Binding TriggerSyncCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- Dynamic Section Views Container -->
            <Grid Grid.Row="1">

                <!-- 0. Overview View -->
                <ScrollViewer x:Name="ViewOverview" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Status Banner -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E4E8" BorderThickness="1">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLanLabel" Text="區域網路探索：" FontSize="13" Foreground="#444444"/>
                                    <TextBlock x:Name="TxtLanValue" Text="在線（相容 Mac Bonjour / Android）" FontSize="13" Foreground="#137333" Margin="0,0,16,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontSize="13" Foreground="#6E6E6E" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Deletion Guard Confirmations Card -->
                        <Border x:Name="CardConfirmations" Background="#FEF7E0" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                BorderBrush="#F9AB00" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtConfirmTitle" Text="⚠️ 待確認大量檔案變更 (防呆保護機制)" FontWeight="Bold" FontSize="14" Foreground="#B06000" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnApproveAll" Content="全部核准" HorizontalAlignment="Right" Padding="12,4" Background="#137333" Foreground="White"
                                            FontWeight="SemiBold" Cursor="Hand" Command="{Binding ApproveAllConfirmationsCommand}"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtConfirmDesc" Text="偵測到單次同步將大量刪除或移動檔案，請核准以繼續執行同步：" FontSize="12" Foreground="#774E00" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding PendingConfirmations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="6" Padding="10,6" Margin="0,2" BorderBrush="#FEEFC3" BorderThickness="1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="核准" Margin="0,0,6,0" Padding="8,3" Background="#137333" Foreground="White" FontSize="11"
                                                                Command="{Binding DataContext.ApproveConfirmationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Content="拒絕" Padding="8,3" Background="#D93025" Foreground="White" FontSize="11"
                                                                Command="{Binding DataContext.DeclineConfirmationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#666666"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Stat Tiles Grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tile 1: Tracked Files -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,6,0" BorderBrush="#E2E4E8" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TileTrackedTitle" Text="📁 追蹤中檔案" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TrackedFilesCount}" FontSize="24" FontWeight="Bold" Foreground="#0078D4"/>
                                    <TextBlock x:Name="TileTrackedSub" Text="跨端點同步檔案總數" FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Tile 2: Deep Verification -->
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="6,0,6,0" BorderBrush="#E2E4E8" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TileVerifyTitle" Text="🛡️ 最近深度驗證" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding LastDeepVerifyText}" FontSize="18" FontWeight="Bold" Foreground="#1E1E1E"/>
                                    <TextBlock Text="{Binding IntegrityStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#137333" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Tile 3: Old Versions -->
                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14" Margin="6,0,0,0" BorderBrush="#E2E4E8" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TileVersionsTitle" Text="🕒 舊版本時光機" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding VersionsCountText}" FontSize="18" FontWeight="Bold" Foreground="#1E1E1E"/>
                                    <TextBlock Text="{Binding VersionsRetentionText}" FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- P2P Peer Card -->
                        <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E4E8" BorderThickness="1">
                            <DockPanel>
                                <TextBlock Text="🌐" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPeerTitle" Text="P2P 區域網路近端加速已就緒" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtPeerDesc" Text="自動探索同網段 Mac、Android 與 Windows 設備，優先以區域網路傳輸大型檔案。" FontSize="12" Foreground="#777777"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1. Preview View -->
                <Grid x:Name="ViewPreview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E4E8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPreviewHeader" Text="差異預覽與試算" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtPreviewDesc" Text="在執行實體寫入前，掃描各端點並檢視將執行的變更清單。" FontSize="12" Foreground="#666666"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnRunPreview" Content="掃描預覽" Padding="12,5" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CCCCCC"
                                        FontWeight="SemiBold" Cursor="Hand" Command="{Binding RunPreviewCommand}"/>
                                <Button x:Name="BtnExecutePreviewSync" Content="立即執行同步" Padding="12,5" Background="#0078D4" Foreground="White"
                                        FontWeight="SemiBold" Cursor="Hand" Command="{Binding ExecutePreviewSyncCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Preview Summary Bar -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PreviewSummaryText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPreviewMore" Text="（僅顯示前 100 筆變更，剩餘將於同步時自動處理）" Foreground="#C5221F" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewHasMore}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <!-- Items List -->
                    <ListView Grid.Row="2" ItemsSource="{Binding PreviewItems}" Background="White" BorderBrush="#E2E4E8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="類型" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="檔案路徑" Width="380" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="來源端點" Width="120" DisplayMemberBinding="{Binding SourceEndpoint}"/>
                                <GridViewColumn Header="目標端點" Width="120" DisplayMemberBinding="{Binding TargetEndpoint}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- 2. Folders View -->
                <Grid x:Name="ViewFolders" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Group Selector Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#E2E4E8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnGroupRestore" Content="從備份還原" Padding="8,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand" Click="BtnGroupRestore_Click"/>
                                <Button x:Name="BtnGroupImport" Content="匯入舊設定" Padding="8,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand" Click="BtnGroupImport_Click"/>
                                <Button x:Name="BtnGroupNew" Content="＋ 新增群組" Padding="8,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand" Click="BtnGroupNew_Click"/>
                                <Button x:Name="BtnGroupEdit" Content="編輯群組" Padding="8,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand" Click="BtnGroupEdit_Click"/>
                                <Button x:Name="BtnGroupDelete" Content="刪除群組" Padding="8,4" Margin="6,0,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Foreground="#C5221F" Cursor="Hand" Click="BtnGroupDelete_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGroupTitle" Text="同步群組" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroupItem, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <TextBlock Text="{Binding IconEmoji}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Group Banner: Status & Pause/Resume -->
                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#E2E4E8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGroupItem.IconEmoji}" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedGroupItem.DisplayName}" FontSize="15" FontWeight="Bold" Margin="0,0,12,0"/>
                                <Border CornerRadius="10" Padding="8,2" Background="#E8F0FE" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GroupStatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#1967D2"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="BtnTogglePause" Content="暫停 / 繼續同步" HorizontalAlignment="Right" Padding="10,4" Background="#FFFFFF"
                                    BorderBrush="#CCCCCC" Cursor="Hand" Command="{Binding TogglePauseGroupCommand}"/>
                        </DockPanel>
                    </Border>

                    <!-- Endpoints List -->
                    <GroupBox x:Name="EndpointsBox" Grid.Row="2" Header="同步端點 (本機 / Google Drive / OneDrive / 外接磁碟)" Padding="8" Background="White"
                              BorderBrush="#E2E4E8" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Endpoints}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10" Margin="0,4" BorderBrush="#EDEDED" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" Foreground="#222222" Margin="0,0,8,0"/>
                                                    <Border Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}" CornerRadius="4" Padding="4,1" Background="#EFEFEF">
                                                        <TextBlock Text="可卸除式" FontSize="10" Foreground="#555555"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Root}" FontSize="12" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" CornerRadius="12" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Background" Value="#E6F4EA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Background" Value="#FCE8E6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Foreground" Value="#137333"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Foreground" Value="#C5221F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Endpoint Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="更換資料夾..." Padding="8,4" Margin="0,0,6,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"
                                                        Tag="{Binding Id}" Click="BtnChangeFolder_Click"/>
                                                <Button Content="移除" Padding="8,4" Background="#FFFFFF" BorderBrush="#CCCCCC" Foreground="#C5221F" Cursor="Hand"
                                                        Tag="{Binding Id}" Click="BtnRemoveEndpoint_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>

                <!-- 3. Activity View -->
                <GroupBox x:Name="ActivityBox" Header="同步動態" Padding="10" Background="White" BorderBrush="#E2E4E8" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <ListBox ItemsSource="{Binding RecentLogs}" BorderThickness="0" Background="Transparent"/>
                        <TextBlock x:Name="TxtActivityEmpty" Text="尚無同步動態" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentLogs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </GroupBox>

                <!-- 4. Conflicts View -->
                <Grid x:Name="ViewConflicts" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E4E8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtConflictHeader" Text="未解決的檔案衝突" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtConflictDesc" Text="當多個設備同時修改相同檔案時，SyncNexus 會保留雙方版本以避免覆蓋。" FontSize="12" Foreground="#666666"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="ListConflictsView" Grid.Row="1" ItemsSource="{Binding OpenConflicts}" Background="White" BorderBrush="#E2E4E8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="端點" Width="100" DisplayMemberBinding="{Binding Endpoint}"/>
                                <GridViewColumn Header="原始檔案" Width="260" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="衝突複本" Width="300" DisplayMemberBinding="{Binding ConflictPath}"/>
                                <GridViewColumn Header="偵測時間" Width="130" DisplayMemberBinding="{Binding Detected}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="BtnKeepMain" Content="保留主要版本 (丟棄衝突複本)" Padding="12,6" Margin="0,0,10,0" Background="#FFFFFF" BorderBrush="#CCCCCC"
                                Cursor="Hand" Click="BtnKeepMain_Click"/>
                        <Button x:Name="BtnKeepConflict" Content="保留衝突複本 (覆蓋為新主版本)" Padding="12,6" Background="#0078D4" Foreground="White" FontWeight="SemiBold"
                                Cursor="Hand" Click="BtnKeepConflict_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 5. Versions View -->
                <Grid x:Name="ViewVersions" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E4E8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock x:Name="TxtVersionsHeader" Text="舊版本時光機" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding VersionsRetentionText}" FontSize="12" Foreground="#666666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblRetentionPolicy" Text="自動清理：" VerticalAlignment="Center" Foreground="#666666" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbRetention" Width="100" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbRetention_SelectionChanged">
                                        <ComboBoxItem Content="7 天" Tag="7"/>
                                        <ComboBoxItem Content="30 天" Tag="30"/>
                                        <ComboBoxItem Content="90 天" Tag="90"/>
                                        <ComboBoxItem Content="永久保留" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnPurgeExpired" Content="清除已過期" Padding="10,5" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CCCCCC"
                                        Cursor="Hand" Command="{Binding PurgeExpiredVersionsCommand}"/>
                                <Button x:Name="BtnPurgeAll" Content="清除全部" Padding="10,5" Background="#FFFFFF" BorderBrush="#CCCCCC" Foreground="#C5221F"
                                        Cursor="Hand" Click="BtnPurgeAll_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding VersionsList}" Background="White" BorderBrush="#E2E4E8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="相對路徑" Width="360" DisplayMemberBinding="{Binding RelativePath}"/>
                                <GridViewColumn Header="快照時間" Width="140" DisplayMemberBinding="{Binding Timestamp}"/>
                                <GridViewColumn Header="來源端點" Width="100" DisplayMemberBinding="{Binding EndpointId}"/>
                                <GridViewColumn Header="操作" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="還原" Padding="6,2" Margin="0,0,6,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"
                                                        Command="{Binding DataContext.RestoreVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Content="刪除" Padding="6,2" Background="#FFFFFF" BorderBrush="#CCCCCC" Foreground="#C5221F" Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- 6. Verify View -->
                <Grid x:Name="ViewVerify" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E4E8" BorderThickness="1">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVerifyHeader" Text="資料完整性深度驗證" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LastDeepVerifyText, StringFormat='上次完整驗證：{0}'}" FontSize="12" Foreground="#666666"/>
                            </StackPanel>
                            <Button x:Name="BtnRunVerify" Content="立即深度驗證" Padding="12,5" HorizontalAlignment="Right" Background="#0078D4" Foreground="White"
                                    FontWeight="SemiBold" Cursor="Hand" Command="{Binding RunDeepVerificationCommand}"/>
                        </DockPanel>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding IntegrityIssues}" Background="White" BorderBrush="#E2E4E8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="問題類型" Width="100" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="檔案路徑" Width="360" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="端點" Width="100" DisplayMemberBinding="{Binding EndpointId}"/>
                                <GridViewColumn Header="偵測時間" Width="140" DisplayMemberBinding="{Binding DetectedAt}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- 7. Settings View -->
                <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Conflict Policy -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E4E8" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingConflictHeader" Text="衝突處理策略" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <RadioButton x:Name="RadioConflictKeepBoth" Content="保留雙方版本 (安全，產生衝突檔案複本)" GroupName="ConflictPolicy"
                                             IsChecked="{Binding IsConflictKeepBoth, Mode=TwoWay}" Margin="0,0,0,6" Checked="SettingsChanged_Handler"/>
                                <RadioButton x:Name="RadioConflictNewerWins" Content="以較新版本覆蓋 (最新優先，覆蓋舊版)" GroupName="ConflictPolicy"
                                             IsChecked="{Binding IsConflictNewerWins, Mode=TwoWay}" Checked="SettingsChanged_Handler"/>
                            </StackPanel>
                        </Border>

                        <!-- Exclude Presets -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E4E8" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingPresetsHeader" Text="排除規則預設集" FontSize="15" FontWeight="Bold" Margin="0,0,8,4"/>
                                <TextBlock x:Name="TxtSettingPresetsDesc" Text="自動略過不需要同步的暫存或系統檔案：" FontSize="12" Foreground="#666666" Margin="0,0,0,10"/>

                                <CheckBox x:Name="ChkPresetSystem" Content="系統與快取 (.DS_Store, Thumbs.db, desktop.ini)"
                                          IsChecked="{Binding PresetSystemJunk, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                                <CheckBox x:Name="ChkPresetOfficeLock" Content="臨時與鎖定檔案 (~$*, *.tmp, *.crdownload)"
                                          IsChecked="{Binding PresetOfficeLock, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                                <CheckBox x:Name="ChkPresetDev" Content="開發環境與相依套件 (node_modules, .git, bin, obj, target)"
                                          IsChecked="{Binding PresetDevArtifacts, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                                <CheckBox x:Name="ChkPresetBuild" Content="套件與構建輸出 (.pytest_cache, dist, build)"
                                          IsChecked="{Binding PresetBuildOutputs, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                                <CheckBox x:Name="ChkPresetOfficeTemp" Content="辦公軟體暫存 (.~lock*, ~$*)"
                                          IsChecked="{Binding PresetOfficeTemp, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                                <CheckBox x:Name="ChkPresetCloud" Content="雲端未下載檔案 (*.cloud, .sync, .dropbox.attr)"
                                          IsChecked="{Binding PresetCloudPlaceholder, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                            </StackPanel>
                        </Border>

                        <!-- Advanced Sync Settings -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E4E8" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingAdvancedHeader" Text="進階同步選項" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkAutoExcludeNested" Content="自動排除巢狀群組路徑 (避免跨群組雙重同步)"
                                          IsChecked="{Binding AutoExcludeNestedGroups, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                                <CheckBox x:Name="ChkCloudSpaceSaving" Content="節省雲端空間 (不觸發未水合雲端佔位符自動下載)"
                                          IsChecked="{Binding CloudSpaceSaving, Mode=TwoWay}" Margin="0,0,0,6" Click="SettingsChanged_Handler"/>
                            </StackPanel>
                        </Border>

                        <!-- System Integration -->
                        <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E4E8" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingSystemHeader" Text="系統整合" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkAutoStart" Content="開機時自動於背景啟動 SyncNexus" VerticalAlignment="Center" Margin="0,0,0,6"
                                          Click="ChkAutoStart_Click"/>
                                <CheckBox x:Name="ChkFolderIcons" Content="資料夾圖示跟隨同步群組" VerticalAlignment="Center"
                                          Click="ChkFolderIcons_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Footer / Status Bar -->
            <StatusBar Grid.Row="2" Background="Transparent" Margin="0,6,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="TxtFooter" Text="✅ 守護行程運作中 · 支援長路徑與雲端佔位符感應 · 系統匣就緒" FontSize="11" Foreground="#888888"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
