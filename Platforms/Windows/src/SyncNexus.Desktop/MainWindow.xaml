<Window x:Class="SyncNexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="🔄" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="SyncNexus" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                    <TextBlock Text="跨平台即時同步中心 (Windows / macOS / Android)" FontSize="12" Foreground="#6E6E6E"/>
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="立即對帳" Padding="14,6" Background="#0078D4" Foreground="White"
                    FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding TriggerSyncCommand}"/>
        </DockPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                BorderBrush="#E5E5E5" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="追蹤中檔案：" FontSize="13" Foreground="#444444"/>
                    <TextBlock Text="{Binding TrackedFilesCount}" FontWeight="Bold" FontSize="13" Foreground="#0078D4"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontSize="13" Foreground="#6E6E6E"/>
            </DockPanel>
        </Border>

        <!-- Endpoints List -->
        <GroupBox Grid.Row="2" Header="同步端點 (本機 / 雲端 / 外接磁碟)" Padding="10" Background="White"
                  BorderBrush="#E5E5E5" BorderThickness="1">
            <ListBox ItemsSource="{Binding Endpoints}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10" Margin="0,4"
                                BorderBrush="#EDEDED" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" Foreground="#222222"/>
                                    <TextBlock Text="{Binding Root}" FontSize="12" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="#E6F4EA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Background" Value="#FCE8E6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="#137333"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Foreground" Value="#C5221F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Footer / Logs -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="✅ 守護行程運作中 · 系統匣隨時就緒" FontSize="12" Foreground="#888888"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
