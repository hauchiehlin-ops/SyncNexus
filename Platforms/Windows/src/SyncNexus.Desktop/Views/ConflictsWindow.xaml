<Window x:Class="SyncNexus.Desktop.Views.ConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="衝突記錄管理" Height="480" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="未解決的檔案衝突" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                <TextBlock Text="當多個設備同時修改相同檔案時，SyncNexus 會保留雙方版本避免覆蓋。" FontSize="12" Foreground="#666"/>
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <ListView x:Name="ListConflicts" Grid.Row="1" Background="White" BorderBrush="#E0E0E0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="端點" Width="90" DisplayMemberBinding="{Binding Endpoint}"/>
                    <GridViewColumn Header="原始檔案" Width="200" DisplayMemberBinding="{Binding Path}"/>
                    <GridViewColumn Header="衝突複本" Width="240" DisplayMemberBinding="{Binding ConflictPath}"/>
                    <GridViewColumn Header="偵測時間" Width="110" DisplayMemberBinding="{Binding Detected}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保留主要版本 (丟棄衝突複本)" Padding="12,6" Margin="0,0,10,0" Click="BtnKeepMain_Click"/>
            <Button Content="保留衝突複本 (覆蓋為新主版本)" Padding="12,6" Background="#0078D4" Foreground="White" FontWeight="SemiBold" Click="BtnKeepConflict_Click"/>
        </StackPanel>
    </Grid>
</Window>
