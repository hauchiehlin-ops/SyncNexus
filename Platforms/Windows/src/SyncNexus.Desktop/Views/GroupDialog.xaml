<Window x:Class="SyncNexus.Desktop.Views.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="260" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="LblName" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBox x:Name="TxtName" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock x:Name="LblIcon" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbIcon" Height="30" Width="120" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Width="80" Height="32" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Width="90" Height="32" Background="#0078D4" Foreground="White" FontWeight="SemiBold" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
