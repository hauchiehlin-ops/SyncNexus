<Window x:Class="SyncNexus.Desktop.Views.DocumentViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncNexus 文件檢視" Height="520" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtDocTitle" Text="操作手冊" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                <TextBlock x:Name="TxtDocSub" Text="SyncNexus 本地優先跨平台檔案同步中心" FontSize="12" Foreground="#666"/>
            </StackPanel>
        </DockPanel>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtDocContent" TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#333"/>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="關閉" Width="100" Height="32" Click="BtnClose_Click" Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
